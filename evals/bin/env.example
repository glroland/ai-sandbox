# EvalHub route (no scheme), from: oc get route -A -l app=eval-hub
EVALHUB_HOST=evalhub-redhat-ods-applications.apps.ocp.home.glroland.com
# Namespace (tenant) where the provider is registered and the evaluation Job runs
EVALHUB_TENANT=redhat-ods-applications
# Bearer token; defaults to `oc whoami -t` if unset
#EVALHUB_TOKEN=

# OpenAI-compatible base URL of the model under test (ending in /v1)
MODEL_URL=https://my-model-my-project.apps.ocp.home.glroland.com/v1
MODEL_NAME=my-model
# Optional: Secret in EVALHUB_TENANT holding `api-key` (and/or `ca_cert`) for the model
#MODEL_SECRET=my-model-api-key

# Optional: pin the promptfoo adapter image (defaults to :latest)
#PROMPTFOO_IMAGE=quay.io/evalhub/community-promptfoo@sha256:8bac0c89fabb0569fec7853ade1f600fbf5132d4971a62d0c26712fdb16df65e
