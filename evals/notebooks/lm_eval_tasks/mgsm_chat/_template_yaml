# Shared settings for the per-language tasks (not a task itself).
dataset_path: juletxara/mgsm
output_type: generate_until
test_split: test
doc_to_text: "{{question.strip()}}\n\nThink step by step, then end your reply with a final line of the form \"Answer: <number>\" (digits only)."
doc_to_target: "{{answer_number|string}}"
target_delimiter: " "
generation_kwargs:
  until:
    - "</s>"
  do_sample: false
  temperature: 0.0
metric_list:
  - metric: exact_match
    aggregation: mean
    higher_is_better: true
    ignore_case: true
    regexes_to_ignore:
      - ","
      - "\\.0+$"
filter_list:
  - name: get_answer
    filter:
      - function: regex
        regex_pattern: "Answer:\\W*(-?[0-9][0-9,]*(?:\\.[0-9]+)?|-?\\.[0-9]+)"
        group_select: -1
        fallback: "[invalid]"
      - function: take_first
metadata:
  version: 1.0
