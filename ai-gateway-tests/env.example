# AI Gateway test configuration
# Copy this file to .env and fill in values for your environment.
# .env is gitignored - never commit real credentials.

# Base URL of the AI gateway's OpenAI-compatible API (no trailing slash)
GATEWAY_BASE_URL=http://localhost:8080/v1

# API key/token used to authenticate to the gateway
GATEWAY_API_KEY=changeme

# Name of the self-hosted model exposed by the gateway
GATEWAY_MODEL=llama3

# Max seconds to wait for a response before failing a test
GATEWAY_TIMEOUT_SECONDS=30
