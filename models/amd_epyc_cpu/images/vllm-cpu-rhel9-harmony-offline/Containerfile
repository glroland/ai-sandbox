# Bakes in the openai-harmony/tiktoken-rs vocab file (o200k_base) that vLLM's
# reasoning_parser=openai_gptoss / tool-call-parser=openai lazily downloads on the
# first chat completion request. Without this, gpt-oss serving breaks on first use
# in disconnected/air-gapped environments, even though the pod reports Ready.
#
# File, URL, cache path, and both hashes below were verified empirically against
# this exact base image (see models/amd_epyc_cpu/gpt-oss-120b-epyc.yaml) by running
# openai_harmony.load_harmony_encoding(HarmonyEncodingName.HARMONY_GPT_OSS) inside a
# live container and inspecting the resulting cache file. No env var is required:
# tiktoken-rs's default cache dir is /tmp/tiktoken-rs-cache, keyed by
# sha1(download_url).hexdigest() as the filename.
FROM registry.redhat.io/rhaii/vllm-cpu-rhel9@sha256:7a28b867955055a8836ea2a78e70b8bad63c1ee50e8a5f8dd95d1194f20ec489

USER root

RUN mkdir -p /tmp/tiktoken-rs-cache && \
    curl -fsSL -o /tmp/tiktoken-rs-cache/fb374d419588a4632f3f557e76b4b70aebbca790 \
      https://openaipublic.blob.core.windows.net/encodings/o200k_base.tiktoken && \
    echo "446a9538cb6c348e3516120d7c08b09f57c36495e2acfffe59a5bf8b0cfb1a2d  /tmp/tiktoken-rs-cache/fb374d419588a4632f3f557e76b4b70aebbca790" | sha256sum -c - && \
    chmod -R a+rX /tmp/tiktoken-rs-cache

USER 1000940000
