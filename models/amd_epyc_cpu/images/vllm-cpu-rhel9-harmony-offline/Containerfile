# Bakes in the openai-harmony/tiktoken-rs vocab file (o200k_base) that vLLM's
# reasoning_parser=openai_gptoss / tool-call-parser=openai lazily downloads on the
# first chat completion request. Without this, gpt-oss serving breaks on first use
# in disconnected/air-gapped environments, even though the pod reports Ready.
#
# The file is baked into /opt/tiktoken and located via TIKTOKEN_ENCODINGS_BASE,
# which openai-harmony reads as a directory containing o200k_base.tiktoken (no
# download, no URL-hash filename). It must NOT live under /tmp, /home, or /mnt:
# LLMInferenceService pods mount emptyDir volumes over those paths, hiding anything
# the image put there (the previous /tmp/tiktoken-rs-cache approach broke this way).
# The env var name was verified against openai-harmony 0.0.8 in this base image.
FROM registry.redhat.io/rhaii/vllm-cpu-rhel9@sha256:7a28b867955055a8836ea2a78e70b8bad63c1ee50e8a5f8dd95d1194f20ec489

USER root

RUN mkdir -p /opt/tiktoken && \
    curl -fsSL -o /opt/tiktoken/o200k_base.tiktoken \
      https://openaipublic.blob.core.windows.net/encodings/o200k_base.tiktoken && \
    echo "446a9538cb6c348e3516120d7c08b09f57c36495e2acfffe59a5bf8b0cfb1a2d  /opt/tiktoken/o200k_base.tiktoken" | sha256sum -c - && \
    chmod -R a+rX /opt/tiktoken

ENV TIKTOKEN_ENCODINGS_BASE=/opt/tiktoken

USER 1000940000
